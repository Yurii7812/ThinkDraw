{
  "name": "thinkdraw",
  "version": "0.1.0",
  "description": "ThinkDraw(仮): ページが一つだけの無限キャンバスで考えを書き散らし、束ねて整理するアプリ",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node build.mjs && xvfb-run -a env THINKDRAW_HEADLESS=1 nice playwright test"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.14.0",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.6.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.43.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
